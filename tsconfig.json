{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "frontend/**/*",
    "components/**/*",
    "database/**/*",
    "backend/**/*",
    "app.js",
    "App.js"
  ]
}
